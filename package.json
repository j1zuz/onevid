{
  "name": "onevid-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "start": "bun --filter web start",
    "web:dev": "bun --filter web dev",
    "web:build": "bun --filter web build",
    "web:start": "bun --filter web start",
    "mobile": "bun --filter onevid start"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.85.3-0",
    "expo-constants": "~56.0.21"
  },
  "trustedDependencies": [
    "esbuild",
    "@posthog/cli",
    "unrs-resolver"
  ],
  "workspaces": {
