{
  "name": "onevid-monorepo",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "start": "bun --filter web start",
    "web:dev": "bun --filter web dev",
    "web:build": "bun --filter web build",
    "web:start": "bun --filter web start",
    "mobile": "bun --filter onevid start",
    "tv:package": "bun --filter tv package",
    "tv:install": "bun --filter tv install:tv",
    "tv:launch": "bun --filter tv launch:tv"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "expo-constants": "~58.0.14"
  },
  "trustedDependencies": [
    "esbuild",
    "@posthog/cli",
    "unrs-resolver"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "lucide-react": "^0.577.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "typescript": "^5"
    }
  },
  "devDependencies": {
    "react-scan": "^0.5.7",
    "web": "workspace:*"
  },
  "patchedDependencies": {
    "expo-libvlc-player@58.0.5": "patches/expo-libvlc-player@58.0.5.patch"
  }
}
