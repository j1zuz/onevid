      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.3.0",
      "@tailwindcss/postcss": "^4.3.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "lucide-react": "^0.577.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.0",
      "typescript": "^5"
    }
  },
  "devDependencies": {
    "react-scan": "^0.5.7",
    "web": "workspace:*"
  },
  "patchedDependencies": {
    "expo-libvlc-player@7.0.40": "patches/expo-libvlc-player@7.0.40.patch"
