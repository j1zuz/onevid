{
  "expo": {
    "name": "onevid",
    "slug": "onevid",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/onevid.png",
    "scheme": "onevid",
    "buildCacheProvider": "eas",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.hackw.onevid"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/onevid.png",
        "monochromeImage": "./assets/images/onevid.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tech.hackw.onevid"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/12ded851-07f6-492d-bd60-76f3e8b412a9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/onevid.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-image",
      "@react-native-tvos/config-tv",
      "./plugins/withTVLeanbackRequired",
      [
        "expo-libvlc-player",
        {
          "localNetworkPermission": "Permite a $(PRODUCT_NAME) acceder a tu red local para reproducir contenido.",
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "onevid accede a tus videos para reproducirlos en la app.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-localization",
      "posthog-react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12ded851-07f6-492d-bd60-76f3e8b412a9"
      }
    },
    "owner": "j1zuz"
  }
}
